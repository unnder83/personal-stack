{
	servers {
		trusted_proxies static 172.28.0.0/16
		trusted_proxies_strict
	}
}

:80 {
	encode gzip

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	handle /api/* {
		reverse_proxy api:8000
	}

	handle /grafana/* {
		basic_auth {
			{$GRAFANA_AUTH_USER} {$GRAFANA_AUTH_HASH}
		}
		reverse_proxy grafana:3000
	}

	handle {
		header {
			Strict-Transport-Security "max-age=31536000"
			Content-Security-Policy "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'"
		}
		reverse_proxy web:8080
	}

	log {
		output stdout
		format json
	}
}
